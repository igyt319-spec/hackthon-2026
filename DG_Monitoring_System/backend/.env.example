# ==============================================================================
# GENIUS DG — SUPABASE CLOUD DATABASE CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate with your Supabase project credentials.
# NEVER commit the actual '.env' file or expose your service-role key to git/frontend.
#
# Where to find these credentials in Supabase:
# 1. Open your Supabase Dashboard: https://supabase.com/dashboard/project/_
# 2. Select your project -> Click 'Project Settings' (gear icon) in sidebar.
# 3. Click 'API' under the Configuration section.
# 4. Copy 'Project URL' into SUPABASE_URL.
# 5. Under 'Project API keys', copy the 'service_role' secret key into SUPABASE_SERVICE_ROLE_KEY.
# ==============================================================================

# Supabase Project REST Endpoint (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (Privileged backend access for Flask API)
# Keep strictly secret! The frontend never sees this key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-here

# Optional: Supabase Anon/Public Key (Read-only / limited client operations)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# Application Environment
FLASK_ENV=development
PORT=5000
